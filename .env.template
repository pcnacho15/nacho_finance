DATABASE_URL="postgres://nacho:123456@127.0.0.1:5432/nacho_finance?schema=public"

# Timezone for the Node process + Postgres connection (single-region app).
# Keeps `timestamp` columns as local wall-clock. Defaults to America/Bogota if unset.
TZ="America/Bogota"

# NextAuth (Auth.js v5)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Pusher Channels — realtime para el chat. Crea una app en https://dashboard.pusher.com
# Si se dejan vacías, el chat sigue funcionando con polling (sin tiempo real).
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
# Las dos siguientes deben tener el MISMO valor que PUSHER_KEY / PUSHER_CLUSTER
# (el prefijo NEXT_PUBLIC_ las expone al navegador).
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""